PORT=3001
NODE_ENV=development

# GenLayer Network Configuration
GENLAYER_RPC_URL=https://studio.genlayer.com/api
DEPLOYER_PRIVATE_KEY=your_genlayer_private_key_here
DEPLOYER_ADDRESS=your_deployer_address_here
CONTRACT_ADDRESS=your_deployed_contract_address_here

# Privy Authentication (Email Sign-In Only)
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://neondb_owner:password@ep-example.pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
